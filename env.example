# Camoufox Connector Configuration
# Copy this file to .env and customize as needed.
# All settings use the CAMOUFOX_ prefix.

# Operating mode: "single" or "pool"
CAMOUFOX_MODE=single

# Number of browser instances (only used in pool mode)
CAMOUFOX_POOL_SIZE=3

# HTTP API port for health checks and management
CAMOUFOX_API_PORT=8080

# Host to bind the HTTP API to
CAMOUFOX_API_HOST=0.0.0.0

# Starting port for browser WebSocket endpoints
CAMOUFOX_WS_PORT_START=9222

# Public WebSocket base URL returned by /next and /endpoints
# Defaults to ws://localhost:${CAMOUFOX_API_PORT} when unset
CAMOUFOX_PUBLIC_WS_URL=ws://localhost:8080

# Browser configuration
CAMOUFOX_HEADLESS=true
CAMOUFOX_GEOIP=true
CAMOUFOX_HUMANIZE=true
CAMOUFOX_BLOCK_IMAGES=false

# Proxy configuration (optional)
# CAMOUFOX_PROXY=http://user:pass@host:port

# Debug mode
CAMOUFOX_DEBUG=false
