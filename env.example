# Camoufox Connector Configuration
# Copy this file to .env and customize as needed.
# All settings use the CAMOUFOX_ prefix.

# Operating mode: "single" or "pool"
CAMOUFOX_MODE=single

# Number of browser instances (only used in pool mode)
CAMOUFOX_POOL_SIZE=3

# HTTP API port for health checks and management
CAMOUFOX_API_PORT=8080

# Host to bind the HTTP API to
CAMOUFOX_API_HOST=0.0.0.0

# Starting port for browser WebSocket endpoints
CAMOUFOX_WS_PORT_START=9222

# Public WebSocket base URL returned by /next and /endpoints
# Defaults to ws://localhost:${CAMOUFOX_API_PORT} when unset
CAMOUFOX_PUBLIC_WS_URL=ws://localhost:8080

# Reservation duration for /next and MCP browser leases (seconds)
CAMOUFOX_LEASE_TIMEOUT=1800

# Browser configuration
CAMOUFOX_HEADLESS=true
CAMOUFOX_GEOIP=true
CAMOUFOX_HUMANIZE=true
CAMOUFOX_BLOCK_IMAGES=false

# Proxy configuration (optional)
# One or more comma-separated proxy URLs (http://, https://, or socks5://user:pass@host:port).
# Commas inside credentials are not supported; percent-encode them instead.
# Proxies are assigned to browser instances by index, cycling when the pool is larger
# than the proxy list. A single proxy applies to all instances.
# CAMOUFOX_PROXY=http://user:pass@host:port
# CAMOUFOX_PROXY=http://p1.example:8080,http://p2.example:8080

# Embedded MCP Streamable HTTP server
CAMOUFOX_MCP_ENABLED=false
CAMOUFOX_MCP_PATH=/mcp
# External MCP Host header (optional; e.g. 10.10.0.11:53000). Do not use *.
# CAMOUFOX_MCP_HOST=10.10.0.11:53000
# Idle browser session expiry (seconds)
CAMOUFOX_MCP_SESSION_TIMEOUT=1800
CAMOUFOX_MCP_STATE_DIR=.camoufox-connector/mcp-state

# Debug mode
CAMOUFOX_DEBUG=false
